{
  "mcpServers": {
    "google-workspace": {
      "command": "uvx",
      "args": ["google-workspace-unlimited"],
      "env": {
        "GOOGLE_CLIENT_ID": "${user_config.google_client_id}",
        "GOOGLE_CLIENT_SECRET": "${user_config.google_client_secret}",
        "GOOGLE_CLIENT_SECRETS_FILE": "${user_config.google_client_secrets_file}",
        "CREDENTIALS_DIR": "${CLAUDE_PLUGIN_DATA}/credentials"
      }
    }
  }
}
